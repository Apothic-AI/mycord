# mycord-email environment
#
# The account's username and password live in
#   $MYCORD_EMAIL_HOME/accounts/<name>/credentials.env   (mode 0600)
# and are written by `mycord-email accounts set-secret <name>`. They are NOT
# configured here — this file only carries paths and defaults.

# Config root. Defaults to $XDG_CONFIG_HOME/mycord-email (~/.config/mycord-email).
# MYCORD_EMAIL_HOME=

# Account to use when -a is not given. Defaults to the account marked `default`.
# MYCORD_EMAIL_ACCOUNT=

# himalaya binary. Defaults to `himalaya` on PATH.
# MYCORD_EMAIL_BINARY=

# Extra himalaya config files to merge AFTER the generated fragment,
# ':'-separated like himalaya's own -c. Defaults to ~/.config/himalaya/config.toml
# when it exists.
# MYCORD_EMAIL_EXTRA_CONFIG=
