# Where the gvoice library lives. Unset means "the sibling directory named gvoice",
# which is the layout in the mycord repo; point it elsewhere if the library moves out.
# GVOICE_ROOT=/home/bitnom/Code/apothic-monorepo-workspace/tooling/mycord/gvoice

# Session file. Defaults to <library>/gv-session.json (mode 0600, gitignored).
# GVOICE_SESSION=

# Node >= 22.18. Defaults to `node` on PATH.
# GVOICE_NODE=

# Session capture. A dash is not a tilde here — spelling these out is safer in a file.
# GVOICE_CHROME=/usr/bin/google-chrome
# GVOICE_CHROME_PROFILE=/home/bitnom/.config/google-chrome/Default
# GVOICE_CHROME_PROFILE_DIR=Default
