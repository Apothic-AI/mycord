# Where session material lives. Defaults to ~/.local/share/mycord-slack/ (mode 0700,
# holding session.json at 0600 and the short-lived slackdump import env file).
# MYCORD_SLACK_STATE=

# Browser profile used by `login`. Default: ~/.config/google-chrome/Default.
# MYCORD_SLACK_CHROME_PROFILE=/home/bitnom/.config/google-chrome/Default
# MYCORD_SLACK_CHROME=/usr/bin/google-chrome

# slackdump binary. Defaults to `slackdump` on PATH.
# MYCORD_SLACK_SLACKDUMP=/home/bitnom/.local/bin/slackdump

# Slack API base URL used by the passthrough and the read verbs. Leave unset: the
# passthrough passes no base_url, so slack_sdk uses https://slack.com/api/, which is
# what routes an xoxc token to its own workspace. Set only to point at a local fixture
# server in tests.
# MYCORD_SLACK_API_BASE=
