#
# Get one from the Discord web app console:
#   1. Open discord.com/app in a browser
#   2. Open Developer Console (F12 / Cmd+Option+I)
#   3. Paste and run:
#      (webpackChunkdiscord_app.push([[''],{},e=>{m=[];for(let c in e.c)m.push(e.c[c])}]),m).find(m=>m?.exports?.default?.getToken).exports.default.getToken()
