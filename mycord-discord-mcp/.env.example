# mycord MCP Server Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Discord user account token (REQUIRED)
# WARNING: Using this token for automation VIOLATES Discord's Terms of Service
# Your account can be BANNED for selfbot activity
# Obtain from: Discord Developer Console > Applications > Bot > Token
# Or use browser console method (see README.md)
DISCORD_TOKEN=your_discord_user_token_here

# Optional: Dry-run mode (not implemented in Slice 1)
# MYCORD_DRY_RUN=false

# Optional: Log level
# LOG_LEVEL=INFO
