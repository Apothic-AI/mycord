# Telegram credentials
#
# api_id and api_hash belong to your APPLICATION, not your account. Register
# one at https://my.telegram.org (API development tools) and paste the values.
# Every official client ships the same public pair, so these are not secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The authorization key, produced by `mycord-telegram-repl login`. This IS the
# account credential: anyone holding it can act as you. Prefer the default
# session file (0600) over this variable.
# TELEGRAM_STRING_SESSION=

# Only needed for --method phone.
# TELEGRAM_PHONE=+15551234567
# TELEGRAM_2FA_PASSWORD=

# Where `login` writes the session string.
# TELEGRAM_STRING_SESSION_FILE=~/.cache/mycord-telegram-repl/session.txt