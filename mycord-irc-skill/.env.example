# IRC server configuration
IRC_SERVER=irc.libera.chat
IRC_PORT=6697
IRC_NICK=mycord-agent
IRC_TLS=true

# Optional IRC identity fields. Defaults are derived from IRC_NICK.
# IRC_USERNAME=mycord-agent
# IRC_REALNAME=mycord agent

# Optional server PASS and SASL credentials. Prefer SASL where available.
# These secrets are read from this file or the environment and are never
# passed on the command line or included in status output.
# IRC_SERVER_PASSWORD=
# IRC_SASL_USERNAME=
# IRC_SASL_PASSWORD=

# Do not disable TLS when using any password or SASL credentials.
